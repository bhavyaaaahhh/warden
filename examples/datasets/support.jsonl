{"id": "refund-second-order", "turns": [{"user": "where is 20"}, {"expect": {"tools": ["lookup_order"], "contains": ["shipped"]}}, {"user": "and refund order 31"}, {"expect": {"tools": ["lookup_order", "refund"], "contains": ["31"]}}]}
{"id": "cancel", "turns": [{"user": "cancel order 64"}, {"expect": {"tools": ["cancel_order"], "contains": ["cancelled"]}}]}
